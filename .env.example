# Copy to .env (same folder as package.json). Existing shell variables win.
# The server reads this file on startup. GitHub Copilot CLI is the only model path.

# Optional. Leave unset to use the model from your Copilot account.
# COPILOT_MODEL=gpt-5.4
# Full path if `copilot` is not on PATH:
# COPILOT_CLI=C:\Users\you\AppData\Local\Programs\GitHub Copilot CLI\copilot.exe
# Full custom-agent timeout, milliseconds:
# COPILOT_AGENT_TIMEOUT_MS=1800000
# Set to 1 only if the Copilot sandbox blocks node on your network:
# COPILOT_DISABLE_SANDBOX=1

# --- corporate proxy (passed through to the Copilot CLI) ---
# Set these in the shell or in this file BEFORE `npm start`. Do not commit real passwords.
# HTTPS_PROXY=http://user:pass@proxy.company.com:8080
# HTTP_PROXY=http://user:pass@proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1,.company.com
# Corporate TLS inspection (self-signed root CA). Copilot reads this variable too:
# NODE_EXTRA_CA_CERTS=C:\certs\company-root-ca.pem

# --- tuning ---
# PORT=3000
# MAX_UPLOAD_MB=20
